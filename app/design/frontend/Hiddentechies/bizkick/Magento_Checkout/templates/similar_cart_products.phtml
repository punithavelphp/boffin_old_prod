 $objectManager = \Magento\Framework\App\ObjectManager::getInstance(); 
    $cart = $this->helper('\Magento\Checkout\Helper\Cart'); 
     if($cart->getQuote()->getId()){ 
		 $items = $cart->getQuote()->getItems();
		 foreach($items as $item) {
		 $productIds[] = $item->getProductId();
			 $qtyArray[$item->getProductId()] = $item->getQty();
	 }
 		 
$productCollection =$objectManager->get('Magento\Catalog\Model\ResourceModel\Product\CollectionFactory')->create()
				->addIdFilter(array('in' => $productIds))
	->addAttributeToSelect('*')
			 ->addMinimalPrice()
            ->addFinalPrice()
            ->addTaxPercents()
            ;
		 
		  
	 


?> 

