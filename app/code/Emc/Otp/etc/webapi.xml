<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <!-- Emc Otp for Generating Otp -->
    <route method="POST" url="/V1/generateOtp">
        <service class="Emc\Otp\Api\GenerateOtpInterface" method="generateOtp"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
	 <route method="POST" url="/V1/validateOtp">
        <service class="Emc\Otp\Api\GenerateOtpInterface" method="validateOtp"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
      
</routes>