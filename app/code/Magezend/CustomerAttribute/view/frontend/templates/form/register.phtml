<script type="application/javascript">
	var  mobileCountryCode;
	var resendclicked = 0;
	var  OTPTIMER = '<?php echo $block->getConfig('otp_settings/general_configuration/interval'); ?>';
	var verfigyMobileText = '<?php echo __('Please verify Phone Number First.'); ?>';



	let digitValidate = function(ele){
		console.log(ele.value);
		ele.value = ele.value.replace(/[^0-9]/g,'');
	}

	let tabChange = function(val){
		let ele  = document.querySelectorAll('#otp_div > *[id]');;
		if(ele[val-1].value != ''){
			ele[val].focus()
		}else if(ele[val-1].value == ''){
			ele[val-2].focus()
		}   
	}


	require([
		'jquery',
		'Magento_Ui/js/modal/modal'
	], function ($, modal) {

		var options = {
			type: 'popup',
			responsive: true,
			innerScroll: true,
			buttons: []
		};
		var popup = modal(options, $('#popup-modal-otp-form'));


		let sT;
		let timerOn = true;
		function clearTimer() {
			clearTimeout(sT);
			document.getElementById("countdown").innerHTML = '';
			document.getElementById("resend").innerHTML = '';
		}



		function timer(remaining) {
			var m = Math.floor(remaining / 60);
			var s = remaining % 60;
			m = m < 10 ? "0" + m : m;
			s = s < 10 ? "0" + s : s;
			document.getElementById("countdown").innerHTML = `Time left: ${m} : ${s}`;
			remaining -= 1;
			if (remaining >= 0 && timerOn) {
				sT = setTimeout(function () {
					timer(remaining);
				}, 1000);
				document.getElementById("resend").innerHTML = '';
				return;
			}
			if (!timerOn) {
				return;
			}
			document.getElementById("resend").innerHTML = 'Dont receive the code? <span class="resend_link font-weight-bold text-color cursor">Resend</span>';
		}


		$(document).on('click', '#triggerOtpCheckout', function() {




			$('#triggerOtpCheckout_message').html('');
			if($("input[name='mobilenumber']").val() == ''){
				$('#triggerOtpCheckout_message').html('Phone Number is required').addClass('error').removeClass('success').show();
				$('.loading-mask').hide();
				return;
			}

			mobilenumber_code =  $("input[name='mobilenumber_code']").val();
			mobilenumber =  $("input[name='mobilenumber']").val();
			var url = "<?= $block->getUrl('otp') ?>";

			$('.loading-mask').show();

			//	 $("#popup-modal-otp-form").html("sending..");
			var r_dis = $(this);
			// r_dis.hide();
			if(resendclicked == 0){
				$('#verify-otp').hide();
				$('#thanks-otp').hide();
				$("#popup-modal-otp-form").modal("openModal");
				$('#sign-in').html('Sending OTP...').addClass('success').removeClass('error');
			}

			if(mobilenumber[0] == '+'){
				mobilenumber = mobilenumber.replace('+'+mobilenumber_code, "");
			}else{
				mobilenumber = mobilenumber.replace(mobilenumber_code, "");
			}


			$.ajax({
				url: url, // url where to submit the request
				type : "POST", // type of action POST || GET
				dataType : 'json', // data type
				data : { 
					'mobilenumber_code':  mobilenumber_code, 
					'mobilenumber': mobilenumber, 
					'type': 'CHANGEMOBILE',
					'otp_arr[]': '',
					'otp_arr[]': '',
					'otp_arr[]': '',
					'otp_arr[]': ''
				},
				success : function(result) {
					//alert($("#modal_hidden").html());
					//	 $("#popup-modal-otp-form").html($("#modal_hidden").html());
					console.log(result.status);
					// var resultData = jQuery.parseJSON(result);
					var resultData = result;
					if (resultData.status){
						$('#message_validate_otp').html(resultData.message).addClass('success').removeClass('error');
						clearTimer() ;
						timer(OTPTIMER);
						resendclicked = 0;
						$('#sign-in').hide();
						$('.otp_inp').val('');
						$('#verify-otp').show();
						$('#validate_otp').attr('disabled', false);
						$("#otp_div #first").focus();
						$('#thanks-otp').hide();

					} else{
						$('#sign-in').html(resultData.message).addClass('error').removeClass('success')
						$('#message_validate_otp').html(resultData.message).addClass('error').removeClass('success');
						if (resultData.exceed == true){
							$('#sign-in').html(resultData.message).addClass('error').removeClass('success').show();
						}
						r_dis.show();
					}

				},
				error: function(xhr, resp, text) {
					//console.log(xhr, resp, text);
				}
			});
			$('.loading-mask').hide();





		}); 



		$(document).on('click', '#resend', function(){
			resendclicked = 1;
			$('#triggerOtpCheckout').click();
			$('#message_validate_otp').html('Sending OTP...');

		});

		$(document).on('click', '#validate_otp', function(){
			$('#message_validate_otp').html('');
			$(this).attr('disabled', 'disabled');
			dis = $(this);
			var validate_url = "<?= $block->getUrl('otp/validate') ?>";

			mobilenumber_code =  $("input[name='mobilenumber_code']").val();
			mobilenumber =  $("input[name='mobilenumber']").val();
			if(mobilenumber[0] == '+'){
				mobilenumber = mobilenumber.replace('+'+mobilenumber_code, "");
			} 
			mobilenumber = mobilenumber.replace(mobilenumber_code, "");
			mobilenumber = mobilenumber.replace(" ", "");
			$("input[name='mobilenumber']").val(mobilenumber);
			otpval = $("#first").val()+''+$("#second").val()+''+$("#third").val()+''+$("#fourth").val();

			$.ajax({
				url: validate_url, // url where to submit the request
				type : "POST", // type of action POST || GET
				dataType : 'json', // data type
				data : { 
					'mobilenumber_code':  mobilenumber_code, 
					'mobilenumber': mobilenumber, 
					'otp_arr': otpval,
					'type': 'CHANGEMOBILE',
				},
				success : function(result) {
					// var resultData = jQuery.parseJSON(result);
					var resultData = (result);
					console.log(resultData);
					if (resultData.status){
						// dataForm.submit();
						$('#sign-in').hide();
						$('#verify-otp').hide();
						$('#thanks-otp').show();
						validateOtp  = 1;
						$('#otp').val(otpval);
						$('#triggerOtpCheckout').hide();
						$('#message_thanks_otp').html(resultData.message).addClass('success').removeClass('error');
						$("#popup-modal-otp-form").modal('closeModal');
						$('#triggerOtpCheckout_message').text(resultData.message).show().addClass('success').removeClass('error');
					} else{
						$('.otp_inp').val('');
						$('#message_validate_otp').html(resultData.message).addClass('error').removeClass('success');

						dis.attr('disabled', false);
					}


				},
				error: function(xhr, resp, text) {
					console.log(xhr, resp, text);
				}
			});
		}); 

	});
</script> 

