<script>
	function paymentMethod(e){
			var pay_method_btn = document.getElementById("payment_method");
		var pay_method = document.getElementById("pay_method");
		 
		if(pay_method.value == ''){
			alert('Payment Method is required.');
			e.preventDefault();
			return false;
		} 
	}
	function paymentMethodBtn(){
			var pay_method_btn = document.getElementById("payment_method");
		var pay_method = document.getElementById("pay_method");
	 
 
		if(pay_method.value == ''){
			alert('Payment Method is required.');
			return false;
		} 
		else{
		document.getElementById("payment_method_frm").submit();
		}
	}
	function displayPayment() {
		var pay_method = document.getElementById("pay_method");
		var divc = document.getElementById("card-payment");
		var divb = document.getElementById("bank-payment")
		divc.style.display = pay_method.value == "C" ? "block" : "none";
		divb.style.display = pay_method.value == "B" ? "block" : "none";
 	}
</script>