<script>
	requirejs([
		"jquery",

		"jquery/ui"
	], function ($) {
		var timerId
		var timeLeft = 15;
		function countdown() {

			if (timeLeft == 0) {
				clearTimeout(timerId);
			} else {
				var elem = document.getElementById('timer');

				elem.innerHTML = timeLeft + ' seconds to initialize...';
				timeLeft--;
			}
		}




		$('#category_id').change(function(){

			data_file =  $('option:selected', this).data('file');
			href_link = '#';
			if(data_file != ''){
				href_link = '<?php echo $this->getUrl(); ?>'+'media/sample/'+data_file; 
			}
			$('#category_id_file').attr('href',href_link);
			$('#category_id_file').text('Sample '+$('option:selected', this).text());

		});
		var full_value;
		$(document).on("click", "#progressbtn", function (e) {
			$(this).hide();
			$('.console').show();
			full_value = "<?php echo $size; ?>";
			$('#file').val(1);
			$('#message_holder').prepend('<p>Processing... Total Count: '+full_value+'</p><p>Sit Back and relax... we are updating your products...</p>');



				$('#timer').show();
				var timerId = setInterval(countdown, 1000);


			callAjax();


		});

		function callAjax(){
		
 			$.ajax({
				url: "<?php echo $this->getUrl('marketplace/product/runuploads'); ?>", 
				type: "GET",
				dataType: "json"

			}).done(function (data) { 
				$('#timer').hide();
				if(data.status == true){
					css_class = '';
				}else{
					css_class = 'error';
				}

				console.log(data);

				resp = data.data;
				for(i=0;i < resp.length;i++){
					sku_data = resp[i];
					if(sku_data.error == 1){
						$('#message_holder').append('<p class="error">'+sku_data.sku+' has error please check and upload again.('+sku_data.message+')</p>');

					}else{
						$('#message_holder').append('<p>'+sku_data.productcode+' updated</p>');
 					}
				}
				$('#message_holder').append('<p class="'+css_class+'">'+data.message+'</p>');
				if(data.progress == 1){
					cur_val = full_value - data.size;
					cVal = parseInt(cur_val);
					$('#file').attr('value',cVal);
					callAjax();
				}else{
					cur_val = full_value - data.size;
					cVal = parseInt(cur_val);
					$('#file').attr('value',cVal);
					$('#message_holder').append('<p>Completed</p>');
				}

			}

				   ).fail(function( jqXHR, textStatus ) {
				alert( "Some Error Occurs: Please try again " + textStatus );
				location.href = location.href;
			});;
		}
	});
</script>


