<script > 
	
    require(
        [
            'jquery',
            'Magento_Ui/js/modal/modal'
        ],
        function(
            $,
            modal
        ) {
            var options = {
                type: 'popup',
                responsive: true,
                innerScroll: true,
                title: 'Request Quote',
                buttons: [{
                    text: $.mage.__('Submit'),
                    class: 'modal_ok',
					 id: 'modal_ok',
                    click: function (e) {
						e.preventDefault();
						var checked = false;
						$('.ck').each(function(){
							if ($(this).is(":checked")){
								checked = true;
							}
						});
						
 						if(checked){
							
						}else{
							alert('Please Select atleast one product');
							return false;
						}
						if($('#qty_quote').val() == '' || $('#qty_quote').val() == 0){
							alert('Quantity is required.');
							return false;
						}
						$('.modal_ok').attr('disabled',true);
						btn = $(this);
						var modalthis = this;
						  var customurl = "<?php echo $this->getUrl('quoterequest'); ?>";
						$.ajax({
							url: customurl,
							type: 'POST',
							dataType: 'json',
							data: $('#quoteFrm').serialize(),
						complete: function(response) { 
							responseJSON = response.responseJSON;
						   console.log('response.message');
 							console.log(responseJSON);
 							$("#message_div").show();
							$("#form_div").hide();
							$('.modal_ok').hide();
 							$("#messagebox").html(responseJSON.message);
							//modalthis.closeModal();
							//country = response.responseJSON.default_country;
							// state = response.responseJSON.state;         
							//console.log(state+' '+country);   
							},
							error: function (xhr, status, errorThrown) {
								$('.modal_ok').attr('disabled',false);
								console.log('Error happens. Try again.');
							}
						});
						
						
                        
                    }
                },
				{
                    text: $.mage.__('Close'),
                    class: 'modal_close hide',
					 id: 'modal_close',
                    click: function () { 
						this.closeModal();
                        
                    }
                }]
            };
 
            var popup = modal(options, $('#quote_modal_content'));
				
				$("#quote_modal_btn").click(function() {
					
					
					
					$("#message_div").hide();
							$("#form_div").show();
					$('.modal_ok').show();
					$('.modal_ok').attr('disabled',false);
					$( '#quoteFrm' ).each(function(){
						this.reset();
					});

				 $('#quote_modal_content').modal('openModal');
					$('.modal-inner-wrap').css('width','100% !important;')
				});
					
           $('.modal-inner-wrap').css('width','100% !important;')
        }	
    );
</script>
