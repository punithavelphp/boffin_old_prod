<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">mtwo_coins_coins_form.coins_form_data_source</item>
		</item>
		<item name="label" xsi:type="string" translate="true">General Information</item>
		<item name="template" xsi:type="string">templates/form/collapsible</item>
	</argument>
	<settings>
		<buttons>
			<button name="back" class="Mtwo\Coins\Block\Adminhtml\Coins\Edit\BackButton"/>
			<button name="delete" class="Mtwo\Coins\Block\Adminhtml\Coins\Edit\DeleteButton"/>
			<button name="save" class="Mtwo\Coins\Block\Adminhtml\Coins\Edit\SaveButton"/>
			<button name="save_and_continue" class="Mtwo\Coins\Block\Adminhtml\Coins\Edit\SaveAndContinueButton"/>
		</buttons>
		<namespace>mtwo_coins_coins_form</namespace>
		<dataScope>data</dataScope>
		<deps>
			<dep>mtwo_coins_coins_form.coins_form_data_source</dep>
		</deps>
	</settings>
	<dataSource name="coins_form_data_source">
		<argument name="data" xsi:type="array">
			<item name="js_config" xsi:type="array">
				<item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
			</item>
		</argument>
		<settings>
			<submitUrl path="*/*/save"/>
		</settings>
		<dataProvider name="coins_form_data_source" class="Mtwo\Coins\Model\Coins\DataProvider">
			<settings>
				<requestFieldName>coins_id</requestFieldName>
				<primaryFieldName>coins_id</primaryFieldName>
			</settings>
		</dataProvider>
	</dataSource>
	<fieldset name="general">
		<settings>
			<label>General</label>
		</settings>
		<field name="is_approved" formElement="checkbox" sortOrder="180">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">coins</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">is_approved</label>
				<dataScope>is_approved</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="coins" formElement="input" sortOrder="190">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">coins</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">coins</label>
				<dataScope>coins</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="approved_by" formElement="textarea" sortOrder="200">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">coins</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">approved_by</label>
				<dataScope>approved_by</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
	</fieldset>
</form>
