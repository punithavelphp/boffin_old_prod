<?xml version="1.0" ?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">mtwo_coins_orders_listing.mtwo_coins_orders_listing_data_source</item>
		</item>
	</argument>
	<settings>
		<spinner>mtwo_coins_orders_columns</spinner>
		<deps>
			<dep>mtwo_coins_orders_listing.mtwo_coins_orders_listing_data_source</dep>
		</deps>
	</settings>
	<dataSource name="mtwo_coins_orders_listing_data_source" component="Magento_Ui/js/grid/provider">
		<settings>
			<storageConfig>
				<param name="indexField" xsi:type="string">orders_id</param>
			</storageConfig>
			<updateUrl path="mui/index/render"/>
		</settings>
		<aclResource>Mtwo_Coins::orders</aclResource>
		<dataProvider name="mtwo_coins_orders_listing_data_source" class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
			<settings>
				<requestFieldName>id</requestFieldName>
				<primaryFieldName>orders_id</primaryFieldName>
			</settings>
		</dataProvider>
	</dataSource>
	<listingToolbar name="listing_top">
		<settings>
			<sticky>true</sticky>
		</settings>
		<bookmark name="bookmarks"/>
		<columnsControls name="columns_controls"/>
		<filters name="listing_filters"/>
		<paging name="listing_paging"/>
	</listingToolbar>
	<columns name="mtwo_coins_orders_columns">
		<selectionsColumn name="ids">
			<settings>
				<indexField>orders_id</indexField>
			</settings>
		</selectionsColumn>
		<column name="orders_id">
			<settings>
				<filter>text</filter>
				<sorting>asc</sorting>
				<label translate="true">ID</label>
			</settings>
		</column>
		<column name="catalog_id">
			<settings>
				<filter>text</filter>
				<sorting>asc</sorting>
				<label translate="true">ID</label>
			</settings>
		</column>
		<column name="catalog_id" class="Mtwo\Coins\Ui\Component\Listing\Column\Catalog">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">text</item>
 					<item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                    <item name="label" xsi:type="string" translate="true">Catalog</item>
                </item>
            </argument>
        </column>
		<column name="customer_name">
			<settings>
				<filter>text</filter>
				<label translate="true">customer_name</label>
			</settings>
		</column>
		<column name="customer_email">
			<settings>
				<filter>text</filter>
				<label translate="true">customer_email</label>
			</settings>
		</column>
		<column name="quantity">
			<settings>
				<filter>text</filter>
				<label translate="true">quantity</label>
			</settings>
		</column>
		 <column name="coins">
			<settings>
				<label translate="true">Coins</label>
			</settings>
		</column>
		 <column name="created_at">
			<settings>
				<label translate="true">Ordered At</label>
			</settings>
		</column>
		<column name="is_approved">
			<settings>
				<filter>text</filter>
				<label translate="true">is_approved</label>
				<editor>
					<editorType>text</editorType>
					<validation>
						<rule name="required-entry" xsi:type="boolean">false</rule>
					</validation>
				</editor>
			</settings>
		</column>
		<actionsColumn name="actions" class="Mtwo\Coins\Ui\Component\Listing\Column\OrdersActions">
			<settings>
				<indexField>orders_id</indexField>
				<resizeEnabled>false</resizeEnabled>
				<resizeDefaultWidth>107</resizeDefaultWidth>
			</settings>
		</actionsColumn>
		<column name="current_status" component="Magento_Ui/js/grid/columns/select">
			<settings>
				<options class="Mtwo\Coins\Model\Config\Source\Status"/>
				<filter>text</filter>
				<dataType>select</dataType>
				<label translate="true">current_status</label>
 			</settings>
		</column>
		<column name="shipping_address">
			<settings>
				<filter>text</filter>
				<label translate="true">shipping_address</label>
			</settings>
		</column>
	</columns>
</listing>
