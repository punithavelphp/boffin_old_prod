<script>
	require(
		[
			'jquery',
			'Magento_Ui/js/modal/modal'
		],
		function (
		$,
		 modal
		) {
			var modaloption = {
				type: 'popup',
				responsive: false,
				innerScroll: true,
				clickableOverlay: true,
				buttons: []
			};
				var modaloptionSuccess = {
				type: 'popup',
				responsive: false,
				innerScroll: true,
				clickableOverlay: true,
				buttons: [],
					backdrop: 'static',
					keyboard: false

			};
			
			var modaloptionSuccess = {
            autoOpen: false,
            responsive: true,
            clickableOverlay: false,
          
             buttons: [{
                text: $.mage.__('Close'),
                class: 'action close-popup wide',
                click: function () {
                    window.location.href = '/freebies';
                }
            }],
            opened: function($Event) {
                $('.modal-header button.action-close', $Event.srcElement).hide();
            },
            keyEventHandlers: {
                escapeKey: function () { return; }
            }
        }
			
			
			var popup = modal(modaloption, $('#modal'));
			$(".productdata").on('click',function(){ 
				$('#modal_image').attr('src',$(this).find('img.pimage').data('image'));
				$('#product_title').html($(this).find('div.pname').data('name'));
				
				$('#product_coins').html($(this).find('div.pcoins').data('coins'));
				$('#product_content').html($(this).find('.desc').html());
				$("#modal").modal("openModal");
			});
			var popup = modal(modaloption, $('#modal_order'));
			var popup2 = modal(modaloptionSuccess, $('#modal_success'));
			
			 
			
			
		 	$(document).on("click",".redeem",function() {
				$(this).attr('disabled',true).find('span').text('Loading...');
				reedemBtn = $(this);
				var customurl = "<?php echo $this->getUrl().'freebies/index/reedem'?>";
				$.ajax({
					url: customurl,
					type: 'GET',
				 
					complete: function(response) {             
						data = response.responseJSON;
  						if(data.status == true){
						 	
 							name = reedemBtn.parents('li.product').find('div.pname').data('name')+ ' -  '+reedemBtn.parents('li.product').find('div.pcoins').data('coins')+ ' Coins' ;
							$('#order_title').html(name);
//			alert(reedemBtn.parents('li.product').find('div.pname').data('catalog'));
							$('#product_id').val(reedemBtn.parents('li.product').find('div.pname').data('catalog'));
						//	$('#order_coins').html(reedemBtn.parents('li.product').find('div.pcoins').data('coins'));
							$('#order_content').html('<p><b>Shipping Address</b></p>'+data.address);
 							$("#modal_order").modal("openModal");
						}else{
							 location.href = location.href;
						}
						
						reedemBtn.attr('disabled',false).find('span').text('Reedem');
					},
					error: function (xhr, status, errorThrown) {
						console.log('Error happens. Try again.');
						reedemBtn.attr('disabled',false).find('span').text('Reedem');
					}
				});

				
				
				
			});
			
			
			$(document).on("click","#confirm_order",function() {
				confirmTxt = $(this).html();
				confirmBtn = $(this);
				confirmBtn.attr('disabled',true).html('Loading...');
				var customurl = "<?php echo $this->getUrl().'freebies/index/order'?>";
				var datastring = $("#freebie_order").serialize();
				$.ajax({
					url: customurl,
					type: 'POST',
				   data: datastring,

					complete: function(response) {        
						
						console.log(response);
						data = response.responseJSON;
						console.log(data);
  						if(data.status == true){
  						/*	name = reedemBtn.parents('li.product').find('div.pname').data('name')+ ' -  '+reedemBtn.parents('li.product').find('div.pcoins').data('coins')+ ' Coins' ;
							$('#order_title').html(name);
						//	$('#order_coins').html(reedemBtn.parents('li.product').find('div.pcoins').data('coins'));
							$('#order_content').html(data.address);
 							*/
							$("#modal_order").modal("closeModal");   
 							$("#modal_success").modal("openModal");
						}
					//	location.href = location.href;
 						confirmBtn.attr('disabled',false).html(confirmTxt);
					},
					error: function (xhr, status, errorThrown) {
						console.log('Error happens. Try again.');
						confirmBtn.attr('disabled',false).html(confirmTxt);
					}
				});

				
				
				
			});
		}
	);
</script>
