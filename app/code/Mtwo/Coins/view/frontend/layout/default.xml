<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>    
     <referenceBlock name="customer_account_navigation">
		  
		  <block class="Magento\Framework\View\Element\Html\Link\Current" name="bbcoins">
                <arguments>
                    <argument name="path" xsi:type="string">freebies/index/coins</argument>
                    <argument name="label" xsi:type="string">BB Coins</argument>
                    <argument name="sortOrder" xsi:type="number">151</argument>
                    <argument name="navigation" xsi:type="boolean">true</argument>
                </arguments>
            </block>
		 <block class="Magento\Framework\View\Element\Html\Link\Current" name="bborders">
                <arguments>
                    <argument name="path" xsi:type="string">freebies/index/orders</argument>
                    <argument name="label" xsi:type="string">Freebies Orders</argument>
                    <argument name="sortOrder" xsi:type="number">151</argument>
                    <argument name="navigation" xsi:type="boolean">true</argument>
                </arguments>
            </block>
        </referenceBlock>

  </body>
</page>
