	$sellerProductArray = $this->getSellerProductArray();
	foreach($sellerProductArray as $productId){
		$productBySeller[$productId] = $productId;
	}
	
}else{
	$tableName = $resource->getTableName('marketplace_saleslist');
	$query = "Select * FROM " . $tableName."  where order_id = '".$sellerOrder->getId()."' and seller_id = '".$sellerid."'"; 
	$result = $connection->fetchAll($query); 
	foreach($result as $res){
		$productBySeller[$res['mageproduct_id']] = $res['mageproduct_id'];
	}
}

