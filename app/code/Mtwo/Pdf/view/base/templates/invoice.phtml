					$sub_total += $item->getData('base_row_total_incl_tax');

					$shipping_charge = ($sellerOrder->getData('shipping_amount') / ($shippingDivider)) * $item->getData('base_row_total_incl_tax');

					$shipping_charges += $shipping_charge;
					$shipping_charge_tax = ($sellerOrder->getData('shipping_tax_amount') / ($shippingDivider)) * $item->getData('base_row_total_incl_tax');

					$shipping_charges_tax += $shipping_charge_tax;
					$grant_item_total = $item->getRowTotal() + $item->getTaxAmount() - $item->getDiscountAmount() + $item->getData('discount_tax_compensation_amount') + $shipping_charge + $shipping_charge_tax;
