			<script type="text/javascript">
				require([
					'jquery',
					'mage/url',
					'Magento_Ui/js/modal/alert'
				], function ($, urlBuilder, alert) {
					'use strict';

					$(document).ready(function() {
						// HSN validation data
						var itemsWithoutHsn = <?= json_encode($itemsWithoutHsn) ?>;

						if (itemsWithoutHsn.length > 0) {
							// Disable submit button initially
							var submitButton = $('#submit_invoice_button, .action-default.scalable.primary, [data-ui-id*="submit"]');
							if (submitButton.length) {
								submitButton.prop('disabled', true)
									.addClass('disabled')
									.css({'opacity': '0.5', 'cursor': 'not-allowed'});

								// Add disabled message
								submitButton.attr('title', '<?= __("Cannot create invoice - missing HSN codes") ?>');

								if (!$('.hsn-submit-error').length) {
									submitButton.after('<div class="hsn-submit-error" style="color: #e22626; font-size: 12px; margin-top: 5px; font-weight: bold;">' +
													   '<?= __("Cannot create invoice - missing HSN codes") ?></div>');
								}
							}

							// Show validation warning at top of items section
							if (!$('#hsn-top-warning').length) {
								$('.order-invoice-tables').prepend(
									 
									'<div id="hsn-top-warning" class="message message-error" style="margin-bottom: 1px;">' +
									'<?= __("HSN is Required") ?>' +
									
									'</div>'
									 
									 
								);
							}
						}

						// Enhanced form submission blocking
						function blockInvoiceCreation(e) {
							if (itemsWithoutHsn.length > 0) {
								e.preventDefault();
								e.stopPropagation();
								e.stopImmediatePropagation();

								var itemLinksHtml = '';
								$.each(itemsWithoutHsn, function(index, item) {
									var editUrl = urlBuilder.build('catalog/product/edit/id/' + item.product_id + '/#product_form_tab_attributes');
									itemLinksHtml += '<li style="margin: 8px 0;"><a href="' + editUrl + 
										'" target="_blank" style="color: #007bdb; text-decoration: none; font-weight: 500;">' +
										item.name + ' (SKU: ' + item.sku + ')</a> ' +
										'<span style="color: #666; font-size: 11px;">- Click to edit</span></li>';
								});

								alert({
									title: '<?= __("Cannot Create Invoice") ?>',
									content: '<div style="margin-bottom: 15px; font-size: 14px;">' +
									'<strong style="color: #e22626;"><?= __("HSN codes missing for the following products:") ?></strong></div>' +
									'<ul style="margin: 10px 0; padding-left: 20px; max-height: 200px; overflow-y: auto;">' + 
									itemLinksHtml + '</ul>' +
									'<div style="margin-top: 15px; padding: 10px; background: #f5f5f5; border-radius: 3px;">' +
									'<strong><?= __("Instructions:") ?></strong><br>' +
									'1. <?= __("Click on any product link above") ?><br>' +
									'2. <?= __("Navigate to the Attributes tab") ?><br>' +
									'3. <?= __("Add the HSN Code value") ?><br>' +
									'4. <?= __("Save the product") ?><br>' +
									'5. <?= __("Return here to create the invoice") ?></div>',
									actions: {
										always: function() {}
									}
								});

								return false;
							}
						}

						// Block multiple submission methods
						$(document).on('submit', '#edit_form, form[data-role="edit-form"], .order-invoice-tables form', blockInvoiceCreation);
						$(document).on('click', '#submit_invoice_button, .action-default.scalable.primary, .submit-invoice', blockInvoiceCreation);

						// Block any AJAX requests that might submit invoice
						var originalAjax = $.ajax;
						$.ajax = function(options) {
							if (itemsWithoutHsn.length > 0 && options.url && options.url.indexOf('invoice') > -1) {
								blockInvoiceCreation({preventDefault: function(){}, stopPropagation: function(){}, stopImmediatePropagation: function(){}});
								return false;
							}
							return originalAjax.apply(this, arguments);
						};
					});
				});
			</script>

